<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="663.0" prefWidth="1130.0" style="-fx-background-color: #0A0F1C;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController.dashboardFormController">
   <children>
      <!-- Blurred AI background -->
      <ImageView fitHeight="663.0" fitWidth="1130.0" preserveRatio="false" pickOnBounds="true" opacity="0.55">
         <image>
            <Image url="@../images/bg_blur.png" />
         </image>
      </ImageView>

      <!-- Glassmorphism sidebar -->
      <AnchorPane prefHeight="671.0" prefWidth="93.0" style="-fx-background-color: rgba(10,15,28,0.75); -fx-border-color: rgba(99,102,241,0.35); -fx-border-width: 0 1 0 0;">
         <children>
            <JFXButton fx:id="btnHistory" onAction="#handleHistory" contentDisplay="TOP" layoutY="449.0" prefHeight="111.0" prefWidth="98.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="History" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="12.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/Order%20History.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
            <JFXButton contentDisplay="TOP" layoutY="560.0" prefHeight="111.0" prefWidth="98.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="About" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="12.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/info_480px.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
            <ImageView fitHeight="59.0" fitWidth="60.0" layoutX="19.0" layoutY="21.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/logo.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>

      <!-- Title with glow -->
      <Label layoutX="128.0" layoutY="28.0" text="DoC Scan" textFill="WHITE">
         <font>
            <Font name="Poppins SemiBold" size="25.0" />
         </font>
         <effect>
            <DropShadow color="#6366F1" radius="18.0" spread="0.15" />
         </effect>
      </Label>

      <!-- Glass Drop Zone -->
      <AnchorPane fx:id="dropPane" layoutX="508.0" layoutY="121.0" prefHeight="468.0" prefWidth="533.0" style="-fx-background-color: rgba(30,41,59,0.55); -fx-border-color: rgba(99,102,241,0.5); -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-style: solid; -fx-border-width: 1.5;">
         <effect>
            <DropShadow color="#6366F1" radius="30.0" spread="0.05" />
         </effect>
         <children>
            <Label layoutX="120.0" layoutY="306.0" text="Drag &amp; drop your file here" textFill="rgba(255,255,255,0.75)">
               <font>
                  <Font name="Poppins Regular" size="16.0" />
               </font>
            </Label>
            <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="189.0" layoutY="129.0" pickOnBounds="true" preserveRatio="true" opacity="0.85">
               <image>
                  <Image url="@../images/image_file.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>

      <!-- Capture Button (Primary Accent + Glow) -->
      <JFXButton fx:id="btnCapture" onAction="#handleCapture" layoutX="182.0" layoutY="240.0" prefHeight="59.0" prefWidth="256.0" style="-fx-background-color: #6366F1; -fx-border-radius: 16; -fx-background-radius: 16; -fx-cursor: hand;" text="    Capture" textFill="WHITE">
         <font>
            <Font name="Poppins Regular" size="16.0" />
         </font>
         <graphic>
            <ImageView fitHeight="28.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/unsplash.png" />
               </image>
            </ImageView>
         </graphic>
         <effect>
            <DropShadow color="#6366F1" radius="20.0" spread="0.2" />
         </effect>
      </JFXButton>

      <!-- Screen Shot Button (Glass) -->
      <JFXButton fx:id="btnScreenshot" onAction="#handleScreenshot" layoutX="182.0" layoutY="320.0" prefHeight="59.0" prefWidth="256.0" style="-fx-background-color: rgba(30,41,59,0.65); -fx-border-radius: 16; -fx-background-radius: 16; -fx-border-color: rgba(99,102,241,0.4); -fx-border-width: 1; -fx-cursor: hand;" text="    Screen Shot" textFill="WHITE">
         <font>
            <Font name="Poppins Regular" size="16.0" />
         </font>
         <graphic>
            <ImageView fitHeight="28.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/screenshot2.png" />
               </image>
            </ImageView>
         </graphic>
      </JFXButton>

      <!-- Browse Button (Glass) -->
      <JFXButton fx:id="btnBrowse" onAction="#handleBrowse" layoutX="182.0" layoutY="399.0" prefHeight="59.0" prefWidth="256.0" style="-fx-background-color: rgba(30,41,59,0.65); -fx-border-radius: 16; -fx-background-radius: 16; -fx-border-color: rgba(99,102,241,0.4); -fx-border-width: 1; -fx-cursor: hand;" text="    Browse Image" textFill="WHITE">
         <font>
            <Font name="Poppins Regular" size="16.0" />
         </font>
         <graphic>
            <ImageView fitHeight="28.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/picture.png" />
               </image>
            </ImageView>
         </graphic>
      </JFXButton>

   </children>
</AnchorPane>
