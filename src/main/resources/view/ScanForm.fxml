<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="851.0" prefWidth="1443.0" stylesheets="@../css/style.css" style="-fx-background-color: #0A0F1C;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ScanFromController.scanFormController">
   <children>

      <!-- Blurred AI background -->
      <ImageView fitHeight="851.0" fitWidth="1443.0" preserveRatio="false" pickOnBounds="true" opacity="0.45">
         <image>
            <Image url="@../images/bg_blur.png" />
         </image>
      </ImageView>

      <!-- Glassmorphism sidebar -->
      <AnchorPane prefHeight="851.0" prefWidth="99.0" style="-fx-background-color: rgba(10,15,28,0.82); -fx-border-color: rgba(99,102,241,0.35); -fx-border-width: 0 1 0 0;">
         <children>
            <ImageView fitHeight="59.0" fitWidth="60.0" layoutX="20.0" layoutY="22.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/logo.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>

      <!-- Top action buttons -->
      <JFXButton fx:id="captureButton" contentDisplay="TOP" layoutX="118.0" layoutY="23.0" prefHeight="81.0" prefWidth="80.0" style="-fx-background-color: #6366F1; -fx-background-radius: 14; -fx-cursor: hand;" text="Capture" textFill="WHITE">
         <font>
            <Font name="Poppins Regular" size="12.0" />
         </font>
         <graphic>
            <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/Camera_208px.png" />
               </image>
            </ImageView>
         </graphic>
         <effect>
            <DropShadow color="#6366F1" radius="16.0" spread="0.15" />
         </effect>
      </JFXButton>

      <JFXButton fx:id="screenshotButton" contentDisplay="TOP" layoutX="204.0" layoutY="23.0" prefHeight="81.0" prefWidth="80.0" style="-fx-background-color: rgba(30,41,59,0.7); -fx-border-color: rgba(99,102,241,0.4); -fx-border-radius: 14; -fx-background-radius: 14; -fx-cursor: hand;" text="Screen Shots" textFill="WHITE">
         <font>
            <Font name="Poppins Regular" size="12.0" />
         </font>
         <graphic>
            <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/screenshot_480px.png" />
               </image>
            </ImageView>
         </graphic>
      </JFXButton>

      <JFXButton fx:id="addButton" contentDisplay="TOP" layoutX="289.0" layoutY="23.0" prefHeight="81.0" prefWidth="80.0" style="-fx-background-color: rgba(30,41,59,0.7); -fx-border-color: rgba(99,102,241,0.4); -fx-border-radius: 14; -fx-background-radius: 14; -fx-cursor: hand;" text="Add" textFill="WHITE">
         <font>
            <Font name="Poppins Regular" size="12.0" />
         </font>
         <graphic>
            <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/add_layer_512px.png" />
               </image>
            </ImageView>
         </graphic>
      </JFXButton>

      <!-- Thumbnail scroll pane -->
      <javafx.scene.control.ScrollPane layoutX="400.0" layoutY="23.0" prefHeight="95.0" prefWidth="750.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" fitToHeight="true" fitToWidth="false">
         <content>
            <javafx.scene.layout.HBox fx:id="thumbnailBox" alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: transparent;" />
         </content>
      </javafx.scene.control.ScrollPane>

      <!-- Left Glass Panel (Image viewer) -->
      <AnchorPane layoutX="110.0" layoutY="128.0" prefHeight="710.0" prefWidth="693.0" style="-fx-background-color: rgba(15,23,42,0.72); -fx-background-radius: 24; -fx-border-color: rgba(99,102,241,0.35); -fx-border-radius: 24; -fx-border-width: 1;">
         <effect>
            <DropShadow color="rgba(99,102,241,0.25)" radius="40.0" spread="0.02" />
         </effect>
         <children>
            <AnchorPane fx:id="leftImagePane" prefHeight="609.0" prefWidth="712.0" style="-fx-background-color: transparent; -fx-background-radius: 24;" />
            <JFXButton fx:id="rotateButton" contentDisplay="TOP" layoutX="10.0" layoutY="615.0" prefHeight="81.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Rotate" textFill="rgba(200,200,255,0.9)">
               <font>
                  <Font name="Poppins Regular" size="12.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/rotate_500px.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
            <JFXButton fx:id="deleteButton" contentDisplay="TOP" layoutX="90.0" layoutY="615.0" prefHeight="81.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Delete" textFill="#FF4757">
               <font>
                  <Font name="Poppins Regular" size="12.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/delete_96px.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
            <JFXButton fx:id="recognizeButton" layoutX="514.0" layoutY="628.0" prefHeight="68.0" prefWidth="181.0" style="-fx-background-color: #6366F1; -fx-background-radius: 16; -fx-cursor: hand;" text="    Recognize" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="16.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="28.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/portrait_mode_scanning_240px.png" />
                     </image>
                  </ImageView>
               </graphic>
               <effect>
                  <DropShadow color="#6366F1" radius="20.0" spread="0.25" />
               </effect>
            </JFXButton>
         </children>
      </AnchorPane>

      <!-- Right Glass Panel (OCR output) -->
      <AnchorPane layoutX="829.0" layoutY="126.0" prefHeight="710.0" prefWidth="603.0" style="-fx-background-color: rgba(15,23,42,0.72); -fx-background-radius: 24; -fx-border-color: rgba(99,102,241,0.35); -fx-border-radius: 24; -fx-border-width: 1;">
         <effect>
            <DropShadow color="rgba(99,102,241,0.25)" radius="40.0" spread="0.02" />
         </effect>
         <children>
            <AnchorPane prefHeight="609.0" prefWidth="603.0" style="-fx-background-color: transparent; -fx-background-radius: 24;" />
            <Label layoutX="30.0" layoutY="18.0" text="OCR Output" textFill="rgba(200,200,255,0.9)">
               <font>
                  <Font name="Poppins Regular" size="16.0" />
               </font>
            </Label>
            <TextArea fx:id="ocrTextArea" layoutX="22.0" layoutY="54.0" prefHeight="524.0" prefWidth="559.0" style="-fx-control-inner-background: rgba(10,15,28,0.95); -fx-text-fill: white; -fx-font-family: 'Poppins'; -fx-font-size: 14px;" wrapText="true" editable="true" promptText="Click Recognize to extract OCR text, or type here..." />
            <JFXButton fx:id="copyButton" contentDisplay="TOP" layoutX="6.0" layoutY="615.0" prefHeight="81.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Copy" textFill="rgba(200,200,255,0.9)">
               <font>
                  <Font name="Poppins Regular" size="12.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/copy_208px.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
            <JFXButton fx:id="saveButton" onAction="#saveImages" contentDisplay="TOP" layoutX="86.0" layoutY="615.0" prefHeight="81.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Save" textFill="#22D3EE">
               <font>
                  <Font name="Poppins Regular" size="12.0" />
               </font>
               <graphic>
                  <ImageView fitHeight="32.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/save_96px.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
            <JFXButton fx:id="exportButton" layoutX="463.0" layoutY="631.0" prefHeight="55.0" prefWidth="118.0" style="-fx-background-color: rgba(30,41,59,0.8); -fx-background-radius: 16; -fx-border-color: rgba(99,102,241,0.5); -fx-border-radius: 16; -fx-cursor: hand;" text="EXPORT" textFill="WHITE">
               <font>
                  <Font name="Poppins Regular" size="16.0" />
               </font>
            </JFXButton>
         </children>
      </AnchorPane>

      <!-- Language selector -->
      <ImageView fitHeight="34.0" fitWidth="30.0" layoutX="1203.0" layoutY="48.0" pickOnBounds="true" preserveRatio="true" opacity="0.85">
         <image>
            <Image url="@../images/language_480px.png" />
         </image>
      </ImageView>
      <Label layoutX="1243.0" layoutY="51.0" text="language" textFill="rgba(200,200,255,0.85)">
         <font>
            <Font name="Poppins Regular" size="16.0" />
         </font>
      </Label>
      <JFXComboBox fx:id="languageBox" focusColor="#6366F1" layoutX="1333.0" layoutY="48.0" prefHeight="25.0" prefWidth="77.0" promptText="Sinhala" style="-fx-text-fill: white;" unFocusColor="rgba(99,102,241,0.4)" visibleRowCount="3" />

   </children>
</AnchorPane>
